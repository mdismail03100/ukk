# ==========================================
# YouTube Data API v3 OAuth Credentials
# ==========================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Generate this once locally by running: python scripts/generate_token.py
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Video upload settings (public, unlisted, private)
YOUTUBE_PRIVACY_STATUS=public

# Optional: Custom Title & Tags
VIDEO_TITLE_PREFIX=Epic Action Scene
VIDEO_TAGS=shorts,action,phonk,edit,cinematic,viral,fyp
